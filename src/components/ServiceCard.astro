---
import type { ServiceEntry } from '../lib/content';
import { serviceHref } from '../lib/content';
import Figure from './Figure.astro';

interface Props {
  service: ServiceEntry;
  index?: number;
}

const { service, index } = Astro.props;
const { data } = service;
const number = typeof index === 'number' ? String(index + 1).padStart(2, '0') : null;
---

<a
  href={serviceHref(service.id)}
  class="group flex h-full flex-col border-t border-line pt-6 transition-colors hover:border-bronze/60"
>
  <div class="flex items-baseline justify-between gap-4">
    {number && <span class="text-[0.65rem] tracking-[0.2em] text-muted">{number}</span>}
    {data.featured && <span class="text-[0.6rem] tracking-[0.2em] uppercase text-bronze">Фокус</span>}
  </div>
  <h3 class="mt-3 font-display text-[1.4rem] leading-snug text-ink group-hover:text-bronze-dark">
    {data.title}
  </h3>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{data.summary}</p>
  <span class="mt-5 inline-flex items-center gap-2 text-[0.7rem] tracking-[0.16em] uppercase text-bronze-dark">
    Детальніше <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
  </span>
</a>
